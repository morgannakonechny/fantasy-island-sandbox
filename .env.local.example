# Yahoo OAuth (original path — still works, used when DATA_SOURCE is unset)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:3000/api/auth/callback

# Set to "scrape" to serve data from the Upstash snapshot (see scripts/scrape-and-push.ts)
# instead of live Yahoo OAuth calls. Leave unset to use the original OAuth path.
DATA_SOURCE=

# Upstash Redis — auto-injected by `vercel integration add upstash/upstash-kv`,
# names are whatever Vercel's marketplace packaging calls them (currently these).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Only needed if your league/team IDs differ from the defaults hardcoded in
# scripts/scrape-and-push.ts.
YAHOO_LEAGUE_ID=
YAHOO_TEAM_ID=
